<script>
/* ===== 1. Conmutador de cantidades ===== */
(function () {
  const botones = document.querySelectorAll('.seg-btn');
  const celdas  = document.querySelectorAll('[data-full]');
  const nota    = document.getElementById('notaRacion');

  const textos = {
    full: 'Compra total: rinde 2 platos de adulto + 1 plato infantil. No sobra comida.',
    unit: 'Ración individual de adulto (≈470 g de sólidos + 480 ml de caldo). La niña come ~1/3 de esta cantidad.'
  };

  botones.forEach(function (btn) {
    btn.addEventListener('click', function () {
      botones.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');

      const modo = btn.dataset.mode; // 'full' | 'unit'
      celdas.forEach(function (celda) {
        celda.textContent = celda.dataset[modo];
      });
      nota.textContent = textos[modo];
    });
  });
})();

/* ===== 2. Animación de aparición al hacer scroll ===== */
(function () {
  const elementos = document.querySelectorAll('.fade');
  if (!('IntersectionObserver' in window)) {
    elementos.forEach(function (el) { el.classList.add('in'); });
    return;
  }
  const obs = new IntersectionObserver(function (entradas) {
    entradas.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

  elementos.forEach(function (el) { obs.observe(el); });
})();

/* ===== 3. Cierre suave del scroll con la barra fija ===== */
document.querySelectorAll('a[href^="#"]').forEach(function (a) {
  a.addEventListener('click', function (ev) {
    const destino = document.querySelector(a.getAttribute('href'));
    if (!destino) return;
    ev.preventDefault();
    const offset = document.querySelector('.topbar').offsetHeight + 12;
    window.scrollTo({
      top: destino.getBoundingClientRect().top + window.pageYOffset - offset,
      behavior: 'smooth'
    });
  });
});
</script>
